BasedOnStyle: LLVM
UseTab: Never
IndentWidth: 4
TabWidth: 4
IndentCaseLabels: false
ColumnLimit: 80
AccessModifierOffset: -4
SortIncludes: true
IncludeBlocks: Regroup
IncludeCategories:
  - Regex:           '^"(.*)\.h"'
    Priority:        -1  
  - Regex:           '^<uvw\.hpp>'
    Priority:        1
  - Regex:           '^<.*\.h'
    Priority:        2
  - Regex:           '^<.*'
    Priority:        3